---
import '../styles/global.css';
import { u } from '../lib';
const { title = '灵巧手趋势' } = Astro.props;
const fonts = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@600&display=swap';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title === '灵巧手趋势' ? title : `${title} · 灵巧手趋势`}</title>
<meta name="description" content="灵巧手领域每日趋势：X、小红书、GitHub、arXiv、微信公众号精选摘要。" />
<link rel="alternate" type="application/rss+xml" title="灵巧手趋势" href={u('/rss.xml')} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0c0b0a" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fonts} />
</head>
<body>
<header class="top">
  <div class="wrap nav">
    <a class="brand" href={u('/')}>
      <span class="brand-tick" aria-hidden="true"></span>
      <span class="brand-name">灵巧手趋势</span>
    </a>
    <nav aria-label="站点">
      <a href={u('/daily/')}>日报</a>
      <a href={u('/weekly/')}>周报</a>
      <a href={u('/tags/')}>标签</a>
      <a href={u('/about/')}>关于</a>
      <a href={u('/rss.xml')}>订阅</a>
    </nav>
  </div>
</header>
<main class="wrap"><slot /></main>
<footer class="colophon">
  <div class="wrap">
    <p class="colophon-name">灵巧手趋势</p>
    <p>内容由 AI 辅助整理，评论仅为摘要，版权归原作者，详见原链接。</p>
    <p class="colophon-links"><a href={u('/rss.xml')}>订阅</a><a href={u('/about/')}>关于与纠错</a></p>
  </div>
</footer>
<a id="totop" href="#" aria-label="回到顶部">↑</a>
<div id="lb" role="dialog" aria-label="图片预览"><img alt="" /><p></p></div>
<script is:inline>(()=>{const lb=document.getElementById('lb'),im=lb.querySelector('img'),cap=lb.querySelector('p');document.addEventListener('click',e=>{const a=e.target.closest('a[data-zoom]');if(a){e.preventDefault();im.src=a.href;const fc=a.parentElement.querySelector('figcaption');cap.textContent=fc?fc.textContent+' · 点击空白处关闭':'';lb.classList.add('on')}else if(e.target.closest('#lb'))lb.classList.remove('on')});addEventListener('keydown',e=>{if(e.key==='Escape')lb.classList.remove('on')})})()</script>
<script is:inline>(()=>{const t=document.getElementById('totop');const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;addEventListener('scroll',()=>t.classList.toggle('on',scrollY>1200),{passive:true});t.addEventListener('click',e=>{e.preventDefault();scrollTo({top:0,behavior:reduce?'auto':'smooth'})})})()</script>
<script is:inline data-goatcounter="https://dexhand-trend.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
