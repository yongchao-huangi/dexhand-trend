---
import Base from '../layouts/Base.astro';
import Glance from '../components/Glance.astro';
import { render } from 'astro:content';
import { all, u, fmt, slug, orderedTags, markedIn } from '../lib';
const { d, w } = await all();
const latest = d[0];
const { Content } = latest ? await render(latest) : { Content: null };
const glance = latest ? markedIn(latest, 'daily') : [];
const weekLabel = w[0] ? w[0].data.title.replace('灵巧手趋势周报 · ', '') : '';
---
<Base>
<section class="hero">
  <p class="kicker">每日精选</p>
  <h1>灵巧手趋势</h1>
  <p class="dek">每天追踪 X、小红书、GitHub、arXiv 与微信公众号上的灵巧手动态。只做精选摘要，附原文链接。</p>
  <ul class="stats">
    <li><b>{d.length}</b><span>日报</span></li>
    <li><b>{w.length}</b><span>周报</span></li>
    <li><b>5</b><span>来源</span></li>
    <li><b>{latest ? fmt(latest.data.date).slice(5) : '--'}</b><span>最近</span></li>
  </ul>
</section>
{w[0] && (
  <a class="weekbanner" href={u(`/weekly/${w[0].id}/`)}>
    <span class="meta">周报</span>
    <span class="week-title">{weekLabel}</span>
    {w[0].data.summary && <span class="week-sum">{w[0].data.summary}</span>}
  </a>
)}
<div class="grid">
  <section class="main">
    {latest && <>
      <p class="meta issue-kicker">每日简报 · <time datetime={fmt(latest.data.date)}>{fmt(latest.data.date)}</time></p>
      <h2 class="issue-title"><a href={u(`/daily/${latest.id}/`)}>{latest.data.title}</a></h2>
      <div class="tags">{orderedTags(latest.data.sources, latest.data.tags).map((t) => <a class="tag" href={u(`/tags/${slug(t)}/`)}>#{t}</a>)}</div>
      <Glance items={glance} />
      <div class="prose"><Content /></div>
    </>}
  </section>
  <aside>
    <h3>最近几期</h3>
    <ul class="list">{d.slice(0, 10).map((e) => <li><a href={u(`/daily/${e.id}/`)}>{fmt(e.data.date)}</a></li>)}</ul>
    <h3>周报</h3>
    <ul class="list">{w.slice(0, 6).map((e) => <li><a href={u(`/weekly/${e.id}/`)}>{e.data.title.replace('灵巧手趋势周报 · ', '')}</a></li>)}</ul>
    <a class="archive-all" href={u('/tags/')}>全部标签</a>
  </aside>
</div>
</Base>
