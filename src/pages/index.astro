---
import Base from '../layouts/Base.astro'; import { render } from 'astro:content'; import { all, u, fmt, slug } from '../lib';
const { d, w } = await all();
const latest = d[0]; const { Content } = latest ? await render(latest) : { Content: null };
---
<Base>
<section class="hero">
  <canvas id="fx" aria-hidden="true"></canvas><div class="scan"></div>
  <div class="kicker">&gt; dexterous_hand.trend --daily</div>
  <h1>灵巧手趋势<br/>Dexterous Hand Radar</h1>
  <p>每天追踪 X、小红书、微信公众号与 arXiv 上的灵巧手动态，偏重触觉。只做精选摘要，附原文链接。</p>
  <div class="stats"><div><b>{d.length}</b><span>DAILY</span></div><div><b>{w.length}</b><span>WEEKLY</span></div><div><b>4</b><span>SOURCES</span></div><div><b>{latest ? fmt(latest.data.date).slice(5) : '--'}</b><span>LATEST</span></div></div>
</section>
{w[0] && <a class="weekbanner" href={u(`/weekly/${w[0].id}/`)}><span class="meta" style="color:var(--p)">WEEKLY // {w[0].data.title.replace('灵巧手趋势周报 · ', '')}</span><b>本周周报 →</b><span>{w[0].data.summary}</span></a>}
<div class="grid">
<section class="main neon">
{latest && <>
  <div class="meta">LATEST // {fmt(latest.data.date)}</div>
  <h2 style="margin:4px 0"><a href={u(`/daily/${latest.id}/`)}>{latest.data.title}</a></h2>
  <div class="tags">{[...latest.data.sources, ...latest.data.tags].map((t) => <a class="tag" href={u(`/tags/${slug(t)}/`)}>#{t}</a>)}</div>
  <div class="prose"><Content /></div>
</>}
</section>
<aside class="neon"><h3>Recent / 最近几期</h3><ul class="list">{d.slice(0, 10).map((e) => <li><a href={u(`/daily/${e.id}/`)}>{fmt(e.data.date)}</a></li>)}</ul>
<h3>Weekly / 周报</h3><ul class="list">{w.slice(0, 6).map((e) => <li><a href={u(`/weekly/${e.id}/`)}>{e.data.title.replace('灵巧手趋势周报 · ', '')}</a></li>)}</ul>
<a class="tag" href={u('/tags/')}>#全部标签</a></aside>
</div>
<script is:inline>
(()=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const c=document.getElementById('fx');if(!c)return;const x=c.getContext('2d');let W,H,P=[];const dpr=Math.min(devicePixelRatio||1,2);
function rs(){W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);const n=Math.round(W*H/9000);P=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35}))}
function f(){x.clearRect(0,0,W,H);for(const p of P){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1}
for(let i=0;i<P.length;i++){const a=P[i];for(let j=i+1;j<P.length;j++){const b=P[j],dx=a.x-b.x,dy=a.y-b.y,d=dx*dx+dy*dy;if(d<9000){x.strokeStyle=`rgba(${i%2?'34,211,238':'168,85,247'},${.25*(1-d/9000)})`;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}
x.fillStyle=i%3?'rgba(103,232,249,.8)':'rgba(192,132,252,.8)';x.fillRect(a.x-1,a.y-1,2,2)}requestAnimationFrame(f)}
addEventListener('resize',rs);rs();f()})();
</script>
</Base>
