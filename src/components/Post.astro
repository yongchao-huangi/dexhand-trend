---
import Base from '../layouts/Base.astro';
import Glance from './Glance.astro';
import { render } from 'astro:content';
import { u, fmt, slug, orderedTags, markedIn } from '../lib';
const { e, kind, prev, next } = Astro.props;
const { Content } = await render(e);
const glance = markedIn(e, kind);
const when = e.data.start ? `${fmt(e.data.start)} ～ ${fmt(e.data.date)}` : fmt(e.data.date);
---
<Base title={e.data.title}>
<article class="post">
  <p class="meta">{kind === 'daily' ? '每日简报' : '周报'} · <time datetime={fmt(e.data.date)}>{when}</time></p>
  <h1>{e.data.title}</h1>
  <div class="tags">{orderedTags(e.data.sources, e.data.tags).map((t: string) => <a class="tag" href={u(`/tags/${slug(t)}/`)}>#{t}</a>)}</div>
  <Glance items={glance} />
  <div class="prose"><Content /></div>
  <nav class="pn" aria-label="前后期">{prev ? <a href={u(`/${kind}/${prev.id}/`)}>← {prev.data.title}</a> : <span />}{next ? <a href={u(`/${kind}/${next.id}/`)}>{next.data.title} →</a> : <span />}</nav>
</article>
</Base>
