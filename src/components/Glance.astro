---
const { items = [] } = Astro.props;
const glance = items.slice().sort((a, b) => b.importance - a.importance || a.order - b.order);
const num = (n) => String(n).padStart(2, '0');
---
{glance.length > 0 && (
<nav class="glance" aria-label="速览">
  <div class="glance-head">
    <h2>速览</h2>
    <p>按重要度</p>
  </div>
  <ol>
    {glance.map((it, i) => (
      <li>
        <a href={`#${it.id}`}>
          <span class="glance-idx" aria-hidden="true">{num(i + 1)}</span>
          <span class="glance-body">
            <span class="glance-title">{it.title}</span>
            {it.section && <span class="glance-sec">{it.section}</span>}
          </span>
          <span class="imp" data-tier={it.importance} aria-label={`重要度 ${it.importance}`}>{it.importance}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
)}
